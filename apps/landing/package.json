{
  "name": "hermes-web-landing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run build:function && bun run build:examples && vite build && vitepress build docs && bun scripts/copy-examples.ts",
    "build:function": "bun build api-src/hermes.ts --target=bun --outfile=api/hermes.mjs",
    "build:examples": "for d in chat auth configuration runs profiles command-center; do (cd ../examples/$d && bun run build) || exit 1; done",
    "preview": "vite preview",
    "docs:dev": "vitepress dev docs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@in-th3-l00p/hermes-remote-examples-backend": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.4.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0",
    "vitepress": "^1.6.4"
  }
}
