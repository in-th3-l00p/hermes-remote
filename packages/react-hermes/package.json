{
  "name": "hermes-web-react",
  "version": "0.1.0",
  "description": "React hooks for the hermes-web API",
  "license": "MIT",
  "author": "Tisca Catalin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/in-th3-l00p/hermes-web.git",
    "directory": "packages/react-hermes"
  },
  "homepage": "https://github.com/in-th3-l00p/hermes-web",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "hermes",
    "hermes-agent",
    "nous-research",
    "react",
    "hooks",
    "agent"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target node --external react --external hermes.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hermes.ts": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
