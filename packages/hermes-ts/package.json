{
  "name": "hermes-web-ts",
  "version": "0.1.0",
  "description": "TypeScript client for the hermes-web API",
  "license": "MIT",
  "author": "Tisca Catalin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/in-th3-l00p/hermes-web.git",
    "directory": "packages/hermes-ts"
  },
  "homepage": "https://github.com/in-th3-l00p/hermes-web",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "hermes",
    "hermes-agent",
    "nous-research",
    "client",
    "agent"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target node && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  }
}
