{
  "name": "@in-th3-l00p/hermes-remote-client",
  "version": "0.2.0",
  "description": "Typed TypeScript client for Hermes Remote",
  "license": "MIT",
  "author": "Tisca Catalin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/in-th3-l00p/hermes-remote.git",
    "directory": "packages/hermes-ts"
  },
  "homepage": "https://hermes-remote.tiscacatalin.com",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "hermes",
    "hermes-agent",
    "nous-research",
    "client",
    "agent"
  ],
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target node && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
