{
  "name": "@intheloop-studio/hermes-remote-client",
  "version": "2.0.1",
  "author": "Tisca Catalin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/in-th3-l00p/hermes-remote.git",
    "directory": "packages/hermes-ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "description": "Typed TypeScript client for Hermes Remote",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "homepage": "https://hermes-remote.tiscacatalin.com",
  "keywords": [
    "hermes",
    "hermes-agent",
    "nous-research",
    "client",
    "agent"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "rm -rf dist && bun build src/index.ts --outdir dist --target node && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "type": "module"
}
