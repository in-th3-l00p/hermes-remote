{
  "name": "hermes-remote",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "integration"
  ],
  "scripts": {
    "test": "bun test packages",
    "test:integration": "cd integration && HERMES_INTEGRATION=1 bun test",
    "test:integration:local": "cd integration && bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "eslint .",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"apps/*/src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"integration/**/*.ts\" \"*.mjs\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"apps/*/src/**/*.{ts,tsx,css}\" \"scripts/**/*.ts\" \"integration/**/*.ts\" \"*.mjs\"",
    "dev": "bun run --filter hermes-remote-chat dev",
    "dev:site": "bun run --filter hermes-remote-site dev",
    "dev:docs": "bun run --filter hermes-remote-site docs:dev"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bun": "^1.2.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "globals": "^17.12.0",
    "openapi-typescript": "^7",
    "prettier": "^3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8"
  }
}
