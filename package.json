{
  "name": "hermes-remote",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "integration"
  ],
  "scripts": {
    "test": "bun test packages",
    "test:integration": "cd integration && HERMES_INTEGRATION=1 bun test",
    "test:integration:local": "cd integration && bun test",
    "typecheck": "bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "openapi-typescript": "^7",
    "typescript": "^5.7.0"
  }
}
